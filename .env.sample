# Option A: Amazon Bedrock via an AWS SSO profile (run `aws sso login --profile YOUR_AWS_PROFILE` if expired).
CLAUDE_CODE_USE_BEDROCK=1
AWS_PROFILE=YOUR_AWS_PROFILE
AWS_REGION=us-east-1
# Only needed if the profile lives in a non-default AWS config file
# AWS_CONFIG_FILE=~/.aws/YOUR_CONFIG_FILE
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-5
ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Option B: use an Anthropic API key instead of Bedrock (remove the Bedrock vars above).
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional, uncomment and set when running without the Slack CLI (npm start).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Optional, uncomment and set for OAuth mode (node app-oauth.js).
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=YOUR_SLACK_REDIRECT_URI

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=https://slack.com/api/

# Proactive mode: weekly digest and anomaly alerts. Leave ALERTS_CHANNEL_ID unset to turn it off.
# Invite the bot to this channel; proactive posts only ever go here.
# ALERTS_CHANNEL_ID=C0123456789
# DIGEST_CRON=0 9 * * 1
# DIGEST_TZ=America/New_York
# Z_THRESHOLD=2
# MIN_SESSIONS=50
# MIN_PERSISTENCE_DAYS=2
# BIG_MOVE_MULTIPLIER=1.5
# STEADY_BAND_PCT=10
# KNOWN_EVENTS_ENABLED=true
# KNOWN_EVENTS_FILE=data/known-events.json
# PROACTIVE_STATE_FILE=data/proactive-state.json

# Only ~10 tools, so skip the deferred tool-search round trip
ENABLE_TOOL_SEARCH=false
